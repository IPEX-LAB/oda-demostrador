    sh:property [ sh:path oda:registro ;
        sh:name "2.3 Compresión"@es ;
        sh:qualifiedValueShape [ sh:path oda:elemento ; sh:hasValue oda:e2_3_compresion ] ;
        sh:qualifiedMinCount 1 ;
        sh:severity sh:Warning ;
        sh:message "2.3 Compresión [opcional (O)]: no consta; no bloquea, pero se tiene en cuenta en la valoración."@es ] ;
    sh:property [ sh:path oda:registro ;

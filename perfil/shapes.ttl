        sh:message "3.2 Vías de migración [obligatorio (C)]: debe cubrirse o declararse como laguna."@es ] ;
    sh:property [ sh:path oda:registro ;
        sh:name "3.3 Suma de comprobación y valores hash"@es ;
        sh:qualifiedValueShape [ sh:path oda:elemento ; sh:hasValue oda:e3_3_hash ] ;

# Lista cerrada de elementos válidos
shp:ElementoValido a sh:NodeShape ;
    sh:targetClass oda:Registro ;
    sh:property [ sh:path oda:elemento ; sh:in ( oda:e1_1_titulo oda:e1_2_creador oda:e1_3_asunto oda:e1_4_descripcion oda:e1_5_fecha oda:e1_6_formato oda:e1_7_identificador oda:e1_8_fuente oda:e1_9_idioma oda:e1_10_relacion oda:e1_11_cobertura oda:e2_1_formato_archivo oda:e2_2_resolucion oda:e2_3_compresion oda:e2_4_profundidad_bits oda:e2_5_metadatos_incrustados oda:e2_6_suma_comprobacion oda:e2_7_tamano oda:e2_8_reproducibilidad_versiones oda:e2_9_dependencias oda:e2_10_relaciones_componentes oda:e3_1_plan_preservacion oda:e3_2_vias_migracion oda:e3_3_hash oda:e3_4_estructura_compleja oda:e3_5_almacenamiento oda:e4_1_estado_derechos oda:e4_2_licencia oda:e4_3_permisos oda:e4_4_propiedad_atribucion oda:e5_1_intencion oda:e5_2_influencias oda:e5_3_simbolismo oda:e5_4_tecnicas oda:e5_5_exposiciones oda:e5_6_recepcion oda:e5_7_contexto_historico oda:e5_8_innovacion oda:e5_9_generos_metodos oda:e5_10_temas ) ;
                  sh:message "El elemento no pertenece al perfil ODA."@es ] .
